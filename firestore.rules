rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own user doc and their own appState.
    // Phase 1 scope: no sharing yet. Sharing dashboards/process flows with other
    // roles (Admin/Analyst/Viewer) will need these rules expanded later —
    // don't build sharing UI without updating this file first, or writes will
    // just fail silently against Firestore's default-deny behavior.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /appState/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else: deny by default (Firestore's default when no rule matches).
  }
}
